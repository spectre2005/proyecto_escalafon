APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Cuentas e instituciones de prueba (db:seed, solo local/testing): iguales en todos los equipos que clonan el proyecto.
# La institución principal usa la base de DB_DATABASE y el administrador ADMIN_*; db:seed aprovisiona además «uno» y
# «dos» (admin.uno@demo.test y admin.dos@demo.test, con ADMIN_PASSWORD). Nunca se crean en producción; ahí se usan
# plataforma:crear-administrador y el aprovisionamiento del panel.
ADMIN_EMAIL=admin.uniq@demo.test
ADMIN_PASSWORD=Demo-Escalafon-2026
PLATAFORMA_ADMIN_EMAIL=superadmin@demo.test
PLATAFORMA_ADMIN_PASSWORD=Demo-Escalafon-2026
PLATAFORMA_PRUEBA_SLUG=uniq
PLATAFORMA_PRUEBA_NOMBRE="Universidad Nacional Intercultural de Quillabamba"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción con HTTPS: true
SESSION_SECURE_COOKIE=false

# Dominios (con puerto) desde los que el SPA usa la cookie de sesión
# *.localhost:5173 cubre las instituciones por subdominio en desarrollo (PLATAFORMA_MODO=subdominio).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,*.localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=escalafon
DB_USERNAME=app
DB_PASSWORD=secret

# Base de la plataforma (panel de superadministración: cuentas de plataforma, instituciones y su auditoría).
# Separada de la base institucional. Las variables sin definir (comentadas) toman el valor de DB_*.
# Con la base creada, aplicar sus migraciones (el «migrate» normal no las recorre):
#   php artisan migrate --database=plataforma --path=database/migrations/plataforma
# En local, db:seed crea la cuenta de prueba (PLATAFORMA_ADMIN_*). En producción no hay registro público ni
# credenciales por defecto; la primera cuenta se crea con:
#   php artisan plataforma:crear-administrador
# PLATAFORMA_DB_DRIVER=pgsql
# PLATAFORMA_DB_HOST=db
# PLATAFORMA_DB_PORT=5432
PLATAFORMA_DB_DATABASE=escalafon_plataforma
# PLATAFORMA_DB_USERNAME=
# PLATAFORMA_DB_PASSWORD=
# PLATAFORMA_DB_SSLMODE=prefer
# Identificación de la institución: unica (por defecto, una sola con la base de arriba) o subdominio
# ({slug}.PLATAFORMA_DOMINIO, cada una con su base y su almacenamiento; el panel solo en el dominio sin subdominio).
# Con subdominio, SESSION_DOMAIN debe quedar en null: la cookie de cada institución es solo de su subdominio.
# En local, db:seed registra las instituciones de prueba (ver PLATAFORMA_PRUEBA_SLUG): {slug}.localhost:5173.
PLATAFORMA_MODO=subdominio
PLATAFORMA_DOMINIO=localhost
# Tiempo de uso pagado: «hoy» se calcula en esta zona horaria (la app corre en UTC) y los administradores de la
# institución ven un aviso desde estos días antes de vencer.
# PLATAFORMA_ZONA_HORARIA=America/Lima
# PLATAFORMA_AVISO_VENCIMIENTO_DIAS=15
# Cookie de sesión del panel (path /api/plataforma); debe ser distinta de SESSION_COOKIE. Por defecto: <app>-plataforma-session.
# PLATAFORMA_SESSION_COOKIE=
