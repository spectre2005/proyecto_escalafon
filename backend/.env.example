APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Cuentas e instituciones de prueba (db:seed, solo local/testing): iguales en todos los equipos que clonan el proyecto.
# La institución principal usa la base de DB_DATABASE y el administrador ADMIN_*; db:seed aprovisiona además «uno» y
# «dos» (admin.uno@demo.test y admin.dos@demo.test, con ADMIN_PASSWORD). Nunca se crean en producción; ahí se usan
# plataforma:crear-administrador y el aprovisionamiento del panel.
ADMIN_EMAIL=admin.uniq@demo.test
ADMIN_PASSWORD=Demo-Escalafon-2026
PLATAFORMA_ADMIN_EMAIL=superadmin@demo.test
PLATAFORMA_ADMIN_PASSWORD=Demo-Escalafon-2026
PLATAFORMA_PRUEBA_SLUG=uniq
PLATAFORMA_PRUEBA_NOMBRE="Universidad Nacional Intercultural de Quillabamba"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción con HTTPS: true
SESSION_SECURE_COOKIE=false

# Dominios (con puerto) desde los que el SPA usa la cookie de sesión
# *.localhost:5173 cubre las instituciones por subdominio en desarrollo (PLATAFORMA_MODO=subdominio).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,*.localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=escalafon
DB_USERNAME=app
DB_PASSWORD=secret

# Base de la plataforma (panel de superadministración: cuentas de plataforma, instituciones y su auditoría).
# Separada de la base institucional. Las variables sin definir (comentadas) toman el valor de DB_*.
# Con la base creada, aplicar sus migraciones (el «migrate» normal no las recorre):
#   php artisan migrate --database=plataforma --path=database/migrations/plataforma
# En local, db:seed crea la cuenta de prueba (PLATAFORMA_ADMIN_*). En producción no hay registro público ni
# credenciales por defecto; la primera cuenta se crea con:
#   php artisan plataforma:crear-administrador
# PLATAFORMA_DB_DRIVER=pgsql
# PLATAFORMA_DB_HOST=db
# PLATAFORMA_DB_PORT=5432
PLATAFORMA_DB_DATABASE=escalafon_plataforma
# PLATAFORMA_DB_USERNAME=
# PLATAFORMA_DB_PASSWORD=
# PLATAFORMA_DB_SSLMODE=prefer
# Identificación de la institución: unica (por defecto, una sola con la base de arriba) o subdominio
# ({slug}.PLATAFORMA_DOMINIO, cada una con su base y su almacenamiento; el panel solo en el dominio sin subdominio).
# Con subdominio, SESSION_DOMAIN debe quedar en null: la cookie de cada institución es solo de su subdominio.
# En local, db:seed registra las instituciones de prueba (ver PLATAFORMA_PRUEBA_SLUG): {slug}.localhost:5173.
PLATAFORMA_MODO=subdominio
PLATAFORMA_DOMINIO=localhost
# Solo con PLATAFORMA_MODO=unica: carpeta propia de la institución de esta base (p. ej. instituciones/uniq) para los
# documentos y fotos. Vacía: las carpetas comunes de siempre. Ponla solo después de normalizar esa carpeta
# (plataforma:normalizar-almacenamiento); si no corresponde a esta base, la aplicación no arranca.
PLATAFORMA_ALMACENAMIENTO_UNICA=
# Tiempo de uso pagado: «hoy» se calcula en esta zona horaria (la app corre en UTC) y los administradores de la
# institución ven un aviso desde estos días antes de vencer.
# PLATAFORMA_ZONA_HORARIA=America/Lima
# PLATAFORMA_AVISO_VENCIMIENTO_DIAS=15
# Cookie de sesión del panel (path /api/plataforma); debe ser distinta de SESSION_COOKIE. Por defecto: <app>-plataforma-session.
# PLATAFORMA_SESSION_COOKIE=
# Consulta de identidad por DNI en el registro manual (docs/CONSULTA_IDENTIDAD.md): ninguno (por defecto), simulado o
# factiliza.
# «simulado» devuelve personas FICTICIAS para los DNI de demostración (00000001 a 00000004; 00000009 simula un
# servicio caído) y solo funciona con APP_ENV=local o testing. No es una consulta a RENIEC. Actívalo solo en un entorno
# de demostración aislado, nunca en una instalación conectada a bases con datos reales. Aún no hay proveedor oficial.
# «factiliza» envía el DNI a un servicio externo de pago (no es RENIEC) y exige FACTILIZA_TOKEN. El token va solo en el
# .env del servidor: nunca en el repositorio ni en variables VITE_.
IDENTIDAD_PROVEEDOR=ninguno
FACTILIZA_TOKEN=

# Buzón al que el docente responde; requiere configurar MAIL_MAILER=smtp y MAIL_* para enviar.
REQUERIMIENTOS_CORREO_RESPUESTA=

# Cuenta institucional de envío: OAuth de Google, no las credenciales de los docentes.
# Crear cliente OAuth de tipo Aplicación web y habilitar Gmail API.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Opcional: copiar la URL exacta mostrada en Configuración > Correo de requerimientos.
# Sin valor se calcula usando el dominio institucional actual (registrarlo en Google).
GMAIL_REDIRECT_URI=

# Fiscalización: validador Firma Perú autorizado, desplegado en la red institucional.
# URL base del módulo, por ejemplo https://validador.interno/validador (sin /api/validation).
# Institución autorizada: slug en modo subdominio; unica en instalación de una institución.
FIRMA_PERU_URL=
FIRMA_PERU_CREDENTIAL=
FIRMA_PERU_INSTITUCION=

# APIsTED: token privado y slug de la institución autorizada. Consultas manuales con créditos.
APISTED_TOKEN=
APISTED_INSTITUCION=
