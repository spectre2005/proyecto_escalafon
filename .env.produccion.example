# Copia este archivo como .env.produccion (no se sube al repositorio) y completa cada valor. Guía: docs/PRODUCCION.md.
# Al arrancar, `php artisan produccion:verificar` rechaza una configuración insegura y el contenedor no inicia.

# --- Aplicación
APP_NAME=Escalafon
APP_ENV=production
APP_DEBUG=false
# Generar con: docker compose --env-file .env.produccion -f docker-compose.produccion.yml run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=https://escalafon.example.pe
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
API_HABILITADA=true
# El CRUD genérico por tabla queda de solo lectura: su escritura salta las reglas de cada sección. No activar.
API_CRUD_GENERICO_ESCRITURA=false
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Instituciones por subdominio: {slug}.PLATAFORMA_DOMINIO; el panel de plataforma en PLATAFORMA_DOMINIO.
PLATAFORMA_MODO=subdominio
PLATAFORMA_DOMINIO=escalafon.example.pe
PLATAFORMA_ZONA_HORARIA=America/Lima
PLATAFORMA_AVISO_VENCIMIENTO_DIAS=15
SANCTUM_STATEFUL_DOMAINS=escalafon.example.pe,*.escalafon.example.pe

# --- Sesiones y caché (en el volumen storage)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=
CACHE_STORE=file
QUEUE_CONNECTION=database

# --- PostgreSQL (el contenedor db se crea con estos datos). Claves de 16 caracteres o más.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=escalafon
DB_USERNAME=escalafon
DB_PASSWORD=
PLATAFORMA_DB_HOST=db
PLATAFORMA_DB_DATABASE=escalafon_plataforma
PLATAFORMA_DB_USERNAME=escalafon
PLATAFORMA_DB_PASSWORD=

# --- HTTPS (Caddy): correo para Let's Encrypt.
ACME_EMAIL=soporte@example.pe
# Solo para probar sin dominio real: CADDY_GLOBAL_EXTRA=local_certs, y otros puertos si 80/443 están ocupados.
# CADDY_GLOBAL_EXTRA=local_certs
# PUERTO_HTTP=80
# PUERTO_HTTPS=443

# --- Correo (avisos futuros); sin configurar, se escribe en el log.
MAIL_MAILER=log
